@page "/ChocoReparaciones/NuevoProducto/crear"
@using ChocoReparaciones.Models
@using ChocoReparaciones.Services
@inject ProductoServices ProductoServices
@inject NavigationManager navigationManager
@rendermode InteractiveServer

<PageTitle>Registrar Producto</PageTitle>

<div class="dashboard-container">
    <div class="main-content">
        <div class="content-header">
            <h2 class="header-title">Registrar Nuevo Producto</h2>
        </div>

        <div class="form-wrapper">
            <div class="form-container">
                <EditForm Model="producto" OnValidSubmit="Guardar">
                    <DataAnnotationsValidator />

                    <div class="form-group">
                        <label class="form-label">Nombre del Producto</label>
                        <InputText class="form-control" @bind-Value="producto.Nombre" placeholder="Ingrese el nombre del producto" />
                        <ValidationMessage For="@(() => producto.Nombre)" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Categoría</label>
                        <InputSelect class="form-control" @bind-Value="producto.Categoria">
                            <option value="">Seleccione una categoría</option>
                            <option>Repuestos</option>
                            <option>Tecnología</option>
                            <option>Herramientas</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => producto.Categoria)" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Descripción</label>
                        <InputTextArea class="form-control" @bind-Value="producto.Descripcion" placeholder="Describa el producto..." rows="4" />
                        <ValidationMessage For="@(() => producto.Descripcion)" />
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Precio (RD$)</label>
                            <InputNumber class="form-control" @bind-Value="producto.Precio" step="0.01" placeholder="0.00" />
                            <ValidationMessage For="@(() => producto.Precio)" />
                        </div>

                        <div class="form-group">
                            <label class="form-label">Cantidad Disponible</label>
                            <InputNumber class="form-control" @bind-Value="producto.CantidadDisponible" placeholder="0" />
                            <ValidationMessage For="@(() => producto.CantidadDisponible)" />
                        </div>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn-primary" disabled="@isProcessing">
                            Guardar Producto
                        </button>
                    </div>

                    <p class="text-center text-danger mt-3">@mensaje</p>
                    <p class="text-center text-success mt-3">@exito</p>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private Producto producto = new();
    private bool isProcessing = false;
    private string? mensaje;
    private string? exito;

    private async Task<bool> Validar()
    {
        var existe = await ProductoServices.ExisteProducto(producto.Id, producto.Nombre ?? "");
        return existe;
    }

    private async Task Guardar()
    {
        mensaje = null;
        exito = null;

        if (await Validar())
        {
            mensaje = "Ya existe un producto con ese nombre.";
            return;
        }

        isProcessing = true;

        var guardado = await ProductoServices.Guardar(producto);

        if (guardado)
        {
            exito = "El producto se creó correctamente.";
            await Task.Delay(1500);
            navigationManager.NavigateTo("/ChocoReparaciones/Inventario");
        }
        else
        {
            mensaje = "No se pudo crear el producto.";
        }

        isProcessing = false;
    }
}
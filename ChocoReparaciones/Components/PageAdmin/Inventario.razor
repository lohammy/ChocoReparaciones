@page "/ChocoReparaciones/Inventario"
@attribute [Authorize(Roles = "Admin,Empleado")]
@using ChocoReparaciones.Models
@using ChocoReparaciones.Services
@using Microsoft.AspNetCore.Authorization
@inject ProductoServices ProductoServices
@inject NavigationManager NavigationManager

@rendermode InteractiveServer

<PageTitle>Inventario</PageTitle>

<div class="dashboard-container">
    <div class="sidebar">
        <div class="sidebar-footer">
            <div class="logo-container">
                <i class="bi bi-tools"></i>
            </div>
        </div>
    </div>

    <div class="main-content">
        <div class="content-header">
            <h2 class="header-title">Inventario de Repuestos</h2>
        </div>

        <div class="search-wrapper">
            <div class="search-container">

                <div class="search-field">
                    <label class="search-label">Buscar pieza</label>
                    <input type="text" class="search-input" @bind="filtroNombre" @bind:event="oninput" placeholder="" />
                </div>

                <div class="search-field">
                    <label class="search-label">Marca</label>
                    <select class="search-select" @onchange="OnMarcaChanged">
                        <option value="">Todas las marcas</option>
                        @foreach (var marca in marcasDisponibles)
                        {
                            <option value="@marca" selected="@(filtroMarca == marca)">@marca</option>
                        }
                    </select>
                </div>

                <div class="search-field">
                    <label class="search-label">Categoría</label>
                    <select class="search-select" @onchange="OnCategoriaChanged">
                        <option value="">Todas las categorías</option>
                        @foreach (var categoria in categoriasDisponibles)
                        {
                            <option value="@categoria" selected="@(filtroCategoria == categoria)">@categoria</option>
                        }
                    </select>
                </div>

                <div class="search-actions">
                    <button type="button" class="btn-search" @onclick="FiltrarProductos">
                        <i class="bi bi-search"></i>
                        <span>Buscar</span>
                    </button>
                </div>

            </div>
        </div>

		        <div class="action-buttons">
            <button type="button" class="btn-secondary" @onclick="LimpiarFiltros">
                <i class="bi bi-arrow-clockwise"></i>
                <span>Limpiar Filtros</span>
            </button>
            <button type="button" class="btn-primary" @onclick="VerProductos">
                <i class="bi bi-grid-3x3-gap-fill"></i>
                <span>Ver Productos</span>
            </button>
        </div>

        @if (productosFiltrados != null && productosFiltrados.Any())
        {
            <div class="results-section">
                <h5 class="results-title">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    Se encontraron @productosFiltrados.Count productos
                </h5>

                <div class="results-list">
                    @foreach (var producto in productosFiltrados)
                    {
                        <div class="result-item">
                            <div class="result-info">
                                <strong>@producto.Nombre</strong>
                                <span class="result-details">Stock: @producto.CantidadDisponible | Precio: RD$ @producto.Precio.ToString("N2")</span>
                            </div>
                            <div class="result-actions">
                                <button class="btn-result" @onclick="() => SeleccionarProducto(producto)">
                                    <i class="bi bi-check-lg"></i>
                                    Seleccionar
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else if (busquedaRealizada && (productosFiltrados == null || !productosFiltrados.Any()))
        {
            <div class="no-results">
                <i class="bi bi-search"></i>
                <h5>No se encontraron productos</h5>
                <p>Intenta ajustar los filtros de búsqueda.</p>
            </div>
        }

        @if (!string.IsNullOrEmpty(mensaje))
        {
            <div class="alert @claseAlerta">
                @mensaje
            </div>
        }
    </div>
</div>

@code {
    private List<Producto>? todosLosProductos;
    private List<Producto>? productosFiltrados;

    private string filtroNombre = "";
    private string filtroMarca = "";
    private string filtroCategoria = "";

    private List<string> marcasDisponibles = new();
    private List<string> categoriasDisponibles = new();

    private bool busquedaRealizada = false;

    private string mensaje = "";
    private string claseAlerta = "alert-info";

    protected override async Task OnInitializedAsync()
    {
        await CargarProductos();
        CargarFiltros();
    }

    private async Task CargarProductos()
    {
        todosLosProductos = await ProductoServices.ListarProductos();
    }

    private void CargarFiltros()
    {
        if (todosLosProductos != null)
        {
            marcasDisponibles = todosLosProductos
                .Select(p => p.Categoria)
                .Distinct()
                .OrderBy(m => m)
                .ToList();

            categoriasDisponibles = todosLosProductos
                .Select(p => p.Categoria)
                .Distinct()
                .OrderBy(c => c)
                .ToList();
        }
    }

    private async Task FiltrarProductos()
    {
        busquedaRealizada = true;

        if (todosLosProductos == null) return;

        productosFiltrados = todosLosProductos.Where(p =>
            (string.IsNullOrEmpty(filtroNombre) || p.Nombre.Contains(filtroNombre, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrEmpty(filtroMarca) || p.Categoria.Equals(filtroMarca, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrEmpty(filtroCategoria) || p.Categoria.Equals(filtroCategoria, StringComparison.OrdinalIgnoreCase))
        ).ToList();

        StateHasChanged();
    }

    private async Task OnMarcaChanged(ChangeEventArgs e)
    {
        filtroMarca = e.Value?.ToString() ?? "";
        await FiltrarProductos();
    }

    private async Task OnCategoriaChanged(ChangeEventArgs e)
    {
        filtroCategoria = e.Value?.ToString() ?? "";
        await FiltrarProductos();
    }

    private void LimpiarFiltros()
    {
        filtroNombre = "";
        filtroMarca = "";
        filtroCategoria = "";
        productosFiltrados = null;
        busquedaRealizada = false;
        StateHasChanged();
    }

    private void VerProductos()
    {
        NavigationManager.NavigateTo("/ChocoReparaciones/InventarioView");
    }

    private void SeleccionarProducto(Producto producto)
    {
        mensaje = $"✅ Producto '{producto.Nombre}' seleccionado.";
        claseAlerta = "alert-success";

        StateHasChanged();

        Task.Delay(3000).ContinueWith(_ =>
        {
            mensaje = "";
            InvokeAsync(StateHasChanged);
        });
    }
}

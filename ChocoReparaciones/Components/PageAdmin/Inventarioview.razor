@page "/ChocoReparaciones/Inventario"
@attribute [Authorize(Roles = "Admin,Tecnico")]
@using ChocoReparaciones.Models
@using ChocoReparaciones.Services
@using Microsoft.AspNetCore.Authorization
@inject ProductoServices ProductoServices
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Inventario de Repuestos</PageTitle>

<div class="container">
	<div class="card shadow-lg">
		<div class="card-header space-between">
			<h5 class="card-title">Inventario de Repuestos</h5>
			<a href="/ChocoReparaciones/NuevoProducto/crear" class="btn btn-primary">
				<span class="bi bi-plus-square"></span> Crear
			</a>
		</div>

		<div class="card-body">
			@*labels*@
			<div class="row">
				@*Filtrar por*@
				<div class="col-3">
					<label class="col-form-label"><strong>Filtrar por</strong></label>
				</div>
				@*ValorFiltro*@
				<div class="col-4">
					<label class="col-form-label"><strong>B&uacute;squeda</strong></label>
				</div>
			</div>

			@*Inputs y botones*@
			<div class="row align-items-center">
				@*filtro*@
				<div class="col-3">
					<InputSelect class="form-select" @bind-Value="Filtro">
						<option value="" selected disabled>Elija una opci&oacute;n</option>
						<option value="Nombre">Nombre</option>
						<option value="Categoria">Categoría</option>
					</InputSelect>
				</div>

				@*Busqueda*@
				<div class="col-4">
					<div class="input-group">
						<input class="form-control" @bind="ValorFiltro" placeholder="Buscar" />
						<button type="button" class="btn btn-outline-primary bi bi-search" @onclick="Buscar"></button>
					</div>
				</div>
			</div>

			<table class="table table-hover">
				<thead class="table table-striped">
					<tr>
						<th>Id</th>
						<th>Nombre</th>
						<th>Descripción</th>
						<th>Categoría</th>
						<th>Stock</th>
						<th>Precio</th>
						<th>Opciones</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var producto in ListaProductos)
					{
						<tr>
							<td>@producto.Id</td>
							<td>@producto.Nombre</td>
							<td>@producto.Descripcion</td>
							<td>@producto.Categoria</td>
							<td>@producto.CantidadDisponible</td>
							<td>@producto.Precio.ToString("C")</td>
							<td class="text-center">
								<a href="/ChocoReparaciones/NuevoProducto/editar/@producto.Id" class="btn btn-secondary bi bi-pencil-square"> Editar</a>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>

		<div class="card-footer space-between">
			<label>Cantidad: @ListaProductos.Count()</label>
		</div>
	</div>
</div>

@code {
	public List<Producto> ListaProductos { get; set; } = new List<Producto>();
	public string Filtro { get; set; } = string.Empty;
	public string ValorFiltro { get; set; } = string.Empty;

	protected override async Task OnInitializedAsync()
	{
		ListaProductos = await ProductoServices.ListarProductos();
	}

	private async Task Buscar()
	{
		if (ValorFiltro.Trim() != "")
		{
			if (Filtro == "Nombre")
			{
				ListaProductos = await ProductoServices.Listar(p => p.Nombre.ToLower().Contains(ValorFiltro.ToLower()));
			}
			else if (Filtro == "Categoria")
			{
				ListaProductos = await ProductoServices.Listar(p => p.Categoria.ToLower().Contains(ValorFiltro.ToLower()));
			}
		}
		else
		{
			ListaProductos = await ProductoServices.ListarProductos();
		}
	}

	private async Task Restablecer()
	{
		ListaProductos = await ProductoServices.ListarProductos();
		Filtro = string.Empty;
		ValorFiltro = string.Empty;
	}
}

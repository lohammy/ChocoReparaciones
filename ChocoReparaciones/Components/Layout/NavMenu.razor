@implements IDisposable
@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.Components.Authorization

<div class="nav-topbar shadow-sm px-4 py-2 d-flex align-items-center justify-content-between">

    <div class="d-flex align-items-center text-white fw-semibold">
        <i class="bi bi-person-circle me-2"></i>
        @contextUser
    </div>

    <div class="nav-pill-container d-flex align-items-center gap-3">

        <NavLink class="nav-pill" href="/admin/dashboard">
            <i class="bi bi-speedometer2 me-2"></i> Dashboard
        </NavLink>

        <NavLink class="nav-pill" href="/admin/ordenes">
            <i class="bi bi-tools me-2"></i> Órdenes
        </NavLink>

        <NavLink class="nav-pill" href="/admin/pedidos">
            <i class="bi bi-truck me-2"></i> Pedidos
        </NavLink>

        <NavLink class="nav-pill" href="/admin/productos/crear">
            <i class="bi bi-plus-circle-dotted me-2"></i> Nuevo Producto
        </NavLink>

        <NavLink class="nav-pill" href="/admin/ajustar-stock">
            <i class="bi bi-boxes me-2"></i> Inventario
        </NavLink>

        <NavLink class="nav-pill" href="/admin/usuarios">
            <i class="bi bi-people-fill me-2"></i> Usuarios
        </NavLink>

        <NavLink class="nav-pill" href="/admin/registrar-empleado">
            <i class="bi bi-person-plus me-2"></i> Nuevo Usuario
        </NavLink>

    </div>

</div>

@code {
    string contextUser = "";

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}

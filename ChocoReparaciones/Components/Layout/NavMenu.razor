@implements IDisposable
@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.Components.Authorization

<div class="nav-topbar shadow-sm px-4 py-2 d-flex align-items-center justify-content-between">
	<div class="d-flex align-items-center text-white fw-semibold">
		<i class="bi bi-person-circle me-2"></i>
		@contextUser
	</div>
	<ul class="nav-link">

		<AuthorizeView Roles="Admin">
			<Authorized>
				<li><a href="/ChocoReparaciones/Usuarios" class="@GetActive("/ChocoReparaciones/Usuarios")">Usuario</a></li>
				<li><a href="/ChocoReparaciones/NuevoProducto/crear" class="@GetActive("/ChocoReparaciones/NuevoProducto")">Nuevo Producto</a></li>
			</Authorized>
		</AuthorizeView>
		@* <li><a href="/" class="@GetActive("/", true)">Home</a></li> *@
		<AuthorizeView Roles="Admin, Tecnico, Cajero">
			<Authorized>
				<li><a href="/ChocoReparaciones/Reparaciones" class="@GetActive("/ChocoReparaciones/Reparacion")">Reparación</a></li>
			</Authorized>
		</AuthorizeView>

		<AuthorizeView Roles="Admin, Tecnico">
			<Authorized>
				<li><a href="/ChocoReparaciones/Inventario" class="@GetActive("/ChocoReparaciones/Inventario")">Inventario</a></li>
			</Authorized>
		</AuthorizeView>
		<li><a href="/Account/Login" class="@GetActive("/Account/Login")">Iniciar sesión</a></li>
	</ul>
</div>

@code {
	string contextUser = "";

	protected override void OnInitialized()
	{
		NavigationManager.LocationChanged += OnLocationChanged;
	}

	private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
	{
		StateHasChanged();
	}

	private string GetActive(string url, bool isHome = false)
	{
		var currentUrl = NavigationManager.Uri;
		var uri = new Uri(currentUrl);
		var path = uri.AbsolutePath;
		if (isHome)
		{
			return (path == "/" || path == "/Home") ? "active" : "";
		}
		else
		{
			return path.StartsWith(url, StringComparison.OrdinalIgnoreCase) ? "active" : "";
		}
	}

	public void Dispose()
	{
		NavigationManager.LocationChanged -= OnLocationChanged;
	}
}
@page "/Account/Register"
@attribute [Authorize(Roles = "Admin")]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using ChocoReparaciones.Data
@using ChocoReparaciones.Models

@inject UserManager<ApplicationUser> UserManager
@inject IUserStore<ApplicationUser> UserStore
@inject ILogger<Register> Logger
@inject NavigationManager NavigationManager

@rendermode InteractiveServer

<PageTitle>Registrar Usuario</PageTitle>
<link href="css/Register.css" rel="stylesheet" />

<div class="register-container">
    <div class="register-brand-section">
        <div class="brand-content">
            <img src="/imagenes/Logo.png" alt="Choco Reparaciones" class="brand-logo-image" />
        </div>
    </div>

    <div class="register-form-section">
        <div class="form-card">
            <div class="welcome-header">
                <h2 class="welcome-title">Registrar Usuario</h2>
            </div>

            <EditForm Model="nuevoUsuario" OnValidSubmit="RegisterUser" class="register-form">
                <DataAnnotationsValidator />

                <div class="form-section">
                    <label class="form-label">Nombre</label>
                    <InputText @bind-Value="nuevoUsuario.Nombre" class="form-control" placeholder="Nombre" />
                    <ValidationMessage For="() => nuevoUsuario.Nombre" class="validation-message" />

                    <label class="form-label mt-3">Email</label>
                    <InputText @bind-Value="nuevoUsuario.Email" class="form-control" placeholder="correo@ejemplo.com" />
                    <ValidationMessage For="() => nuevoUsuario.Email" class="validation-message" />
                </div>

                <div class="form-section">
                    <label class="form-label">Contraseña</label>
                    <InputText type="password" @bind-Value="nuevoUsuario.Contrasena" class="form-control" placeholder="Contraseña" />
                    <ValidationMessage For="() => nuevoUsuario.Contrasena" class="validation-message" />

                    <label class="form-label mt-3">Confirmar Contraseña</label>
                    <InputText type="password" @bind-Value="confirmPassword" class="form-control" placeholder="Confirme su contraseña" />
                    @if (!string.IsNullOrEmpty(passwordError))
                    {
                        <div class="validation-message">@passwordError</div>
                    }
                </div>

                <div class="form-section">
                    <label class="form-label">Rol</label>
                    <InputSelect @bind-Value="nuevoUsuario.Rol" class="form-control">
                        <option value="">Seleccione un rol</option>
                        <option value="Cajero">Cajero</option>
                        <option value="Tecnico">Técnico</option>
                    </InputSelect>
                    <ValidationMessage For="() => nuevoUsuario.Rol" class="validation-message" />
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn-register" disabled="@isProcessing">
                        <span>Registrar</span>
                    </button>
                </div>

                <div class="login-link">
                    ¿Ya tienes cuenta?
                    <a href="/Account/Login">Inicia sesión</a>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private Usuario nuevoUsuario = new();
    private string confirmPassword = string.Empty;
    private string passwordError = string.Empty;
    private bool isProcessing = false;

    public async Task RegisterUser()
    {
        if (nuevoUsuario.Contrasena != confirmPassword)
        {
            passwordError = "Las contraseñas no coinciden.";
            return;
        }

        isProcessing = true;

        try
        {
            var user = Activator.CreateInstance<ApplicationUser>()!;
            await UserStore.SetUserNameAsync(user, nuevoUsuario.Email, CancellationToken.None);
            var emailStore = (IUserEmailStore<ApplicationUser>)UserStore;
            await emailStore.SetEmailAsync(user, nuevoUsuario.Email, CancellationToken.None);
            user.EmailConfirmed = true;

            var result = await UserManager.CreateAsync(user, nuevoUsuario.Contrasena);
            if (result.Succeeded && !string.IsNullOrEmpty(nuevoUsuario.Rol))
            {
                await UserManager.AddToRoleAsync(user, nuevoUsuario.Rol);
            }

            NavigationManager.NavigateTo("/Account/Login");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error creating user");
        }
        finally
        {
            isProcessing = false;
        }
    }

    public class Usuario
    {
        public string Nombre { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Contrasena { get; set; } = string.Empty;
        public string Rol { get; set; } = string.Empty;
    }
}